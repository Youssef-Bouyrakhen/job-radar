# Copy this file to ".env" and fill in your own values.
# Never share your .env file with anyone.

# Telegram (Phase 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Gemini (Phase 4) - get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional backups, used when Gemini hits its limit (all have free keys):
# https://console.groq.com/keys and https://openrouter.ai/settings/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Cloudflare Workers AI (free 10,000 neurons a day): dash.cloudflare.com -> AI -> Workers AI ->
# "Use REST API": the Account ID and an API token with "Workers AI: Read" (free plan only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# GitHub Models: a fine-grained token with "Models: read-only" (https://github.com/settings/tokens)
GITHUB_MODELS_TOKEN=
# Off in config.yaml (they need a payment method)
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
TINYFISH_API_KEY=

# Gmail inbox for job-alert emails (Phase 6)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional, for testing: other database file / don't start the scheduler
# JOBRADAR_DB=
# JOBRADAR_NO_SCHEDULER=
